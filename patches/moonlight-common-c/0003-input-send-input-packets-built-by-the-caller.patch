+// LuzLunar's patch: queues an input packet built by the caller, for protocol extensions
+int LiSendForkInputPacket(const void* packet, uint32_t length, uint8_t channelId, bool reliable) {
+    PPACKET_HOLDER holder;
+    NV_INPUT_HEADER header;
+    int extraLength;
+    int err;
+
+    if (!initialized) {
+        return -2;
+    }
+
+    // The packet must be a whole input packet that the send thread can encrypt
+    if (packet == NULL || length < sizeof(NV_INPUT_HEADER) || length > MAX_INPUT_PACKET_SIZE) {
+        return -3;
+    }
+    memcpy(&header, packet, sizeof(header));
+    if (BE32(header.size) + sizeof(uint32_t) != length) {
+        return -3;
+    }
+
+    // A packet larger than the holder's union needs an extended holder
+    extraLength = (int)length - (int)sizeof(holder->packet);
+    holder = allocatePacketHolder(extraLength > 0 ? extraLength : 0);
+    if (holder == NULL) {
+        return -1;
+    }
+
+    holder->channelId = channelId;
+    holder->enetPacketFlags = reliable ? ENET_PACKET_FLAG_RELIABLE : 0;
+    memcpy(&holder->packet, packet, length);
+
+    err = LbqOfferQueueItem(&packetQueue, holder, &holder->entry);
+    if (err != LBQ_SUCCESS) {
+        LC_ASSERT(err == LBQ_BOUND_EXCEEDED);
+        Limelog("Input queue reached maximum size limit\n");
+        freePacketHolder(holder);
+    }
+
+    return err;
+}
