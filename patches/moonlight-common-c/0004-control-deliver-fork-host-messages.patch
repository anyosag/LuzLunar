+// A control message from the host whose type is in the range LuzLunar's anyosag/Apollo keeps for
+// its own protocol extensions, 0x4C00 to 0x4CFF: payload is what follows the type, decrypted,
+// length bytes. It's called on the control stream's receive thread, in the order the host sent
+// them, so it must return quickly; payload is only valid during the call. (LuzLunar's patch, not
+// upstream.)
+typedef void(*ConnListenerForkHostMessage)(uint16_t type, const uint8_t* payload, int length);
+
+// This function sets the callback above, or clears it with NULL. Set it before LiStartConnection()
+// and clear it after LiStopConnection(): messages arriving without one are dropped. (LuzLunar's
+// patch, not upstream.)
+void LiSetForkHostMessageCallback(ConnListenerForkHostMessage callback);
+
 // This function returns a time in microseconds with an implementation-defined epoch.
