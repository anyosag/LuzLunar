<RCC>
    <!-- Fork QML lives in app/gui so upstream QML can use it as a same-folder type -->
    <qresource prefix="/gui">
        <file alias="ForkSettingsGroupBox.qml">../gui/ForkSettingsGroupBox.qml</file>
        <file alias="StreamProfileDialog.qml">../gui/StreamProfileDialog.qml</file>
    </qresource>
</RCC>
